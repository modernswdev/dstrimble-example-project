    "test:integration": "jest --runInBand test/*.integration.test.js",
    "test:ui": "jest --runInBand test/*.ui.test.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cookie-parser": "^1.4.6",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "jsdom": "^24.1.3"
  },
  "jest": {
    "setupFiles": ["<rootDir>/test/jest.setup.js"],
    "testEnvironment": "node",
    "testTimeout": 20000
  }
